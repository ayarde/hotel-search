# Puertos publicados en el host.
APP_PORT=8080
KAFKA_EXTERNAL_PORT=9092
ORACLE_PORT=1521

# Credenciales locales. Reemplazar estos valores antes de usar el stack.
# ORACLE_PWD administra la instancia; DB_PASSWORD pertenece al usuario
# hotel_search usado por la aplicación y por Flyway.
ORACLE_PWD=change_me_oracle_admin
DB_PASSWORD=change_me_hotel_search

# Configuración operativa opcional.
DB_POOL_MAX_SIZE=10
SHUTDOWN_TIMEOUT=20s
KAFKA_CONSUMER_GROUP_ID=hotel-search-consumer
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=3000
KAFKA_CLOSE_TIMEOUT=10s

# Identificador estable del cluster KRaft. No es un secreto.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
