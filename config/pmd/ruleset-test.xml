<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="hotel-search-tests"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Reglas PMD comunes a unit e integration tests de Hotel Search. Parte del
        ruleset principal completo, con sus exclusiones, ajustes y reglas
        propias. Acá solo figura lo que cambia en tests: las reglas que solo
        generan ruido en código de test y las reglas propias que verifican las
        convenciones de TESTING_RULES.md.
    </description>

    <!-- Misma convención que el ruleset principal: una regla que se excluye
         y se vuelve a referenciar más abajo está configurada, no
         desactivada. -->

    <!-- ===================== base: ruleset principal ===================== -->
    <!-- PMD resuelve la ruta relativa a este archivo, no al directorio de
         trabajo, así que la referencia funciona igual desde Gradle o desde
         un IDE. Gradle no sabe que este ruleset lee el otro: build.gradle.kts
         declara ruleset.xml como input de las tareas que usan este archivo.
         Cualquier cambio en ruleset.xml alcanza también a los tests. -->
    <rule ref="ruleset.xml">
        <!-- bestpractices: un test verifica un comportamiento, que puede
             requerir varias aserciones sobre el mismo resultado (por ejemplo,
             los campos de un mensaje consumido de Kafka). -->
        <exclude name="UnitTestContainsTooManyAsserts"/>
        <!-- bestpractices: TESTING_RULES.md §3 pide que los mensajes de
             assert estén en español cuando se usan, pero no exige uno en cada
             aserción: el nombre del test y el mensaje de AssertJ ya describen
             el fallo. -->
        <exclude name="UnitTestAssertionsShouldIncludeMessage"/>

        <!-- codestyle: los tests importan estáticamente las aserciones y los
             matchers de AssertJ, Mockito y Awaitility. -->
        <exclude name="TooManyStaticImports"/>
        <!-- codestyle: TESTING_RULES.md §2 pide que el nombre del test empiece
             con el método bajo prueba. Para toCommand o toHotelSearch, la
             regla toma el test como un método de conversión que devuelve
             void. -->
        <exclude name="LinguisticNaming"/>
        <!-- codestyle: se configura abajo con el formato de
             TESTING_RULES.md §2. -->
        <exclude name="MethodNamingConventions"/>

        <!-- design: declarar throws Exception en un método de test es
             idiomático; JUnit reporta cualquier excepción como fallo del
             test. -->
        <exclude name="SignatureDeclareThrowsException"/>
        <!-- design: una clase de test tiene un método por escenario; muchos
             métodos es normal y no indica una clase con demasiadas
             responsabilidades. -->
        <exclude name="TooManyMethods"/>
        <!-- design: los tests de integración importan clases de Spring, Kafka,
             Testcontainers y del dominio a la vez. -->
        <exclude name="ExcessiveImports"/>
        <exclude name="CouplingBetweenObjects"/>

        <!-- documentation: TESTING_RULES.md §4 exige Javadoc en todo test,
             pero los métodos de test son package-private y CommentRequired
             solo controla miembros públicos y protegidos, así que no los
             cubre. XPath tampoco puede leer comentarios en PMD 7, por lo
             que esa regla se sigue revisando a mano. -->
        <exclude name="CommentRequired"/>

        <!-- errorprone: los datos de prueba repiten literales (ids, nombres de
             topics) a propósito; cada test se lee de forma independiente. -->
        <exclude name="AvoidDuplicateLiterals"/>

        <!-- Regla propia: la inyección por campo (@Autowired) se acepta en
             tests. JUnit crea la instancia de la clase de test, y es la forma
             habitual con @SpringBootTest. -->
        <exclude name="AvoidFieldInjection"/>
    </rule>

    <!-- TESTING_RULES.md §2: methodUnderTesting_StateUnderTest, con uno o
         más segmentos en PascalCase separados por guion bajo
         (submit_ValidRequest_ReturnsSearchId). Los helpers siguen en
         camelCase. -->
    <rule ref="category/java/codestyle.xml/MethodNamingConventions">
        <properties>
            <property name="junitJupiterTestPattern" value="[a-z][a-zA-Z0-9]*(_[A-Z][a-zA-Z0-9]*)+"/>
        </properties>
    </rule>

    <!-- ===================== reglas propias de tests ===================== -->
    <!-- Las dos se prueban con los fixtures de config/pmd/fixtures y la tarea
         verifyPmdTestRules de build.gradle.kts. -->

    <!-- TESTING_RULES.md §5: primero los tests y al final los helpers
         privados. -->
    <rule name="TestHelpersAtEnd"
          language="java"
          message="Mover el helper privado al final de la clase, después de todos los tests"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Los métodos auxiliares privados van agrupados al final de la clase,
            dentro del editor-fold de Helpers. No se intercalan entre tests.
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//ClassBody/MethodDeclaration[@Visibility = 'private']
    [following-sibling::MethodDeclaration
        [ModifierList/Annotation[@SimpleName = ('Test', 'ParameterizedTest', 'RepeatedTest')]]]
                ]]></value>
            </property>
        </properties>
    </rule>

    <!-- TESTING_RULES.md §8.1: imagen de Testcontainers con versión pinneada. -->
    <rule name="PinnedContainerImage"
          language="java"
          message="Pinnear la versión de la imagen; no usar :latest ni omitir el tag"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Detecta imágenes con :latest y nombres de imagen sin tag pasados a
            DockerImageName.parse o al constructor de un container.
            Límite: solo inspecciona literales String pasados directamente. Una
            imagen que llega desde una constante o una variable no se revisa;
            hoy todas las imágenes son literales directos, como en el patrón
            de TESTING_RULES.md §8.
        </description>
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
(: Cualquier literal que termine en :latest :)
//StringLiteral[ends-with(@ConstValue, ':latest')]
|
(: Literal sin tag pasado al constructor de un container :)
//ConstructorCall[ClassType[ends-with(@SimpleName, 'Container')]]
    /ArgumentList/StringLiteral[not(contains(@ConstValue, ':'))]
|
(: Literal sin tag pasado a DockerImageName.parse :)
//MethodCall[@MethodName = 'parse'][TypeExpression/ClassType[@SimpleName = 'DockerImageName']]
    /ArgumentList/StringLiteral[not(contains(@ConstValue, ':'))]
                ]]></value>
            </property>
        </properties>
    </rule>
</ruleset>
